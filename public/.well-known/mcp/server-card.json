{
  "$schema": "https://modelcontextprotocol.io/schemas/server-card/v1.json",
  "serverInfo": {
    "name": "Maine Coon Heaven",
    "version": "1.0.0",
    "description": "Maine Coon Heaven Australia is a trusted registered Maine Coon breeder in Sydney, NSW, offering purebred Maine Coon kittens for sale to loving homes in Sydney, Melbourne, Canberra, Perth, Adelaide, and across Australia.",
    "homepage": "https://DOMAIN.com",
    "contact": {
      "email": "mainecoonheavenus@gmail.com",
      "whatsapp": "+61 401 667 279"
    }
  },
  "transport": {
    "type": "streamable-http",
    "endpoint": "https://DOMAIN.com/api/mcp"
  },
  "capabilities": {
    "tools": [
      {
        "name": "search_products",
        "description": "Search Maine Coon kittens by keyword, category, or max_price",
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string"
            },
            "category": {
              "type": "string"
            },
            "max_price": {
              "type": "number"
            }
          }
        }
      },
      {
        "name": "get_product",
        "description": "Get full kitten details by slug",
        "inputSchema": {
          "type": "object",
          "required": [
            "slug"
          ],
          "properties": {
            "slug": {
              "type": "string"
            }
          }
        }
      },
      {
        "name": "list_categories",
        "description": "List all kitten categories",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "get_policies",
        "description": "Get kitten transport, health guarantees, payment methods, and crypto discounts",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "create_order_draft",
        "description": "Create prefilled kitten inquiry and reservation URL. Human completes — never captures payment.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array"
            },
            "notes": {
              "type": "string"
            }
          }
        }
      }
    ],
    "resources": [
      {
        "name": "product-catalog",
        "description": "Full kitten catalog",
        "uri": "https://DOMAIN.com/shop/"
      },
      {
        "name": "blog",
        "description": "Maine Coon care and breed guides",
        "uri": "https://DOMAIN.com/blog/"
      }
    ],
    "commerce": {
      "ordering": "human-assisted-whatsapp-or-form",
      "payment": [
        "Bank Transfer",
        "PayID",
        "crypto-BTC",
        "crypto-USDT"
      ],
      "currency": "AUD",
      "minimumOrder": 0,
      "freeShipping": 0
    }
  },
  "legal": {
    "ageRestriction": "none",
    "productType": "pedigree-kittens",
    "compliance": "ethical-preservation-breeder"
  }
}
